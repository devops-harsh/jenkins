pipeline {
    agent any

    stages {
        stage('checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/devops-harsh/jenkins.git'
            }
        }
        
        stage('Build') {
            steps {
              dir('java-jenkins-docker-app') {
                sh ' mvn clean package'
        }         
            }
        }
        
        stage(' Test ') {
            steps {
              dir('java-jenkins-docker-app') {
                sh ' mvn test'
        }         
            }
        }
        
         stage(' Compile ') {
            steps {
                dir('java-jenkins-docker-app') {
                sh ' mvn compile'
        }         
            }
        }
        
         stage(' Docker Build ') {
            steps {
                dir('java-jenkins-docker-app') {
                sh 'docker build -t java:latest .'
        }         
            }
        }
        
         stage(' Docker run ') {
            steps {
                dir('java-jenkins-docker-app') {
                sh ' docker run -d --name java2 java:latest'
        }         
            }
        }
        
        stage(' Docker tag ') {
            steps {
                sh ' docker tag java:latest harsh2409/java:latest '
            }
        }
        
          stage(' Docker Login ') {
            steps {
                sh ' docker login -u username -p password'
            }
        }
        
        stage(' Docker push ') {
            steps {
                sh ' docker push harsh2409/java:latest'
            }
        }
        
         stage('clean workspace ') {
            steps {
                cleanWs()
            }
        }
        
    }
}
